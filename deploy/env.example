# Copy to the shell environment before ./deploy.sh, or export the variables
# you want to override. deploy.sh uses these defaults when unset.
# The exporter is a standalone Deployment in this namespace. It is not a
# sidecar on a MaaS pod. The default matches the pricing UI namespace.
FINOPS_NAMESPACE=maas-finops-ui
UI_NAMESPACE=maas-finops-ui
OBS_NAMESPACE=redhat-ods-monitoring
MAAS_NAMESPACE=models-as-a-service
# Applied to the Grafana instance as dashboards and folders. The dashboard selects dashboards=<this value>.
GRAFANA_LABEL=grafana
# UBI image built from grafana/Containerfile. The Grafana operator runs this image.
# GRAFANA_IMAGE=image-registry.openshift-image-registry.svc:5000/maas-finops-ui/maas-tokenomics-grafana:0.1.0
PERSES_DATASOURCE=data-science-prometheus-datasource
# APPLY_LOG_RBAC=true
# APPLY_NETWORK_POLICY=false
# EXPORTER_IMAGE=image-registry.openshift-image-registry.svc:5000/maas-finops-ui/maas-tokenomics-exporter:0.1.0
# UI_IMAGE=image-registry.openshift-image-registry.svc:5000/maas-finops-ui/maas-tokenomics-ui:0.1.0
# Match the cluster version: oc get clusterversion -o jsonpath='{.status.desired.version}{"\n"}'
# OAUTH_PROXY_IMAGE=registry.redhat.io/openshift4/ose-oauth-proxy-rhel9:v4.18
# Phase 5. Open WebUI is built from openwebui/Containerfile. Set OPENAI_API_KEY
# before the first deploy; it is stored in ojoseph-test-agent-secret and is not written to git.
# CARAVAN_NAMESPACE=test-project
# CARAVAN_AGENT_IMAGE=registry.custom.mirror/caravan-agent:dev1
# Cluster imagestream openshift/python:3.12-ubi9. Used by ojoseph-test-agent.
# CARAVAN_BASE_IMAGE=image-registry.openshift-image-registry.svc:5000/openshift/python:3.12-ubi9
# OPENWEBUI_IMAGE=image-registry.openshift-image-registry.svc:5000/test-project/open-webui:0.1.0
# OPENAI_BASE_URL=https://maas.apps.ocp.tlphn.sandbox983.opentlc.com/v1
# OPENAI_MODEL=publishers/llm/models/gemma-2-9b-it
